{
	email {$TLS_EMAIL}
}

{$CORE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	@private_api path /api/*
	handle @private_api {
		reverse_proxy 127.0.0.1:8081
	}

	handle {
		respond "Not Found" 404
	}
}
